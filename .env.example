# nodeloop environment configuration
# Copy this file to .env and adjust values. .env is gitignored.

# Node.js version used by nodeloop when spawning child processes
NODELOOP_NODE_VERSION=24

# Working directory for the watched project
NODELOOP_CWD=.

# Port the debug inspector binds to (when --inspect is used)
NODELOOP_INSPECT_PORT=9229

# Log level: error | warn | info | debug
NODELOOP_LOG_LEVEL=info

# Disable color output (useful in CI / non-TTY)
NO_COLOR=

# File watching backend: native | polling
NODELOOP_WATCH_BACKEND=native

# Debounce delay in milliseconds before restarting after a file change
NODELOOP_DEBOUNCE_MS=100

# Grace period in milliseconds before force-killing the process tree
NODELOOP_GRACE_MS=5000
